<?xml version="1.0" encoding="utf-8"?><!--
	The "jump back" pill: a compact tonal chip that floats above the navigation bar, fully rounded so
	it reads as part of the same floating system as the bar.
-->
<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:clickable="true"
	android:focusable="true"
	app:cardBackgroundColor="?attr/colorPrimaryContainer"
	app:cardCornerRadius="20dp"
	app:cardElevation="6dp"
	app:rippleColor="?attr/colorOnPrimaryContainer"
	app:strokeWidth="0dp">

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="14dp"
		android:paddingVertical="9dp">

		<ImageView
			android:layout_width="18dp"
			android:layout_height="18dp"
			android:layout_gravity="center_vertical"
			android:contentDescription="@null"
			android:src="@drawable/ic_jump_back"
			app:tint="?attr/colorOnPrimaryContainer" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:layout_marginStart="6dp"
			android:includeFontPadding="false"
			android:text="@string/list_checkpoint"
			android:textAppearance="?attr/textAppearanceLabelLarge"
			android:textColor="?attr/colorOnPrimaryContainer" />

	</LinearLayout>

</com.google.android.material.card.MaterialCardView>
