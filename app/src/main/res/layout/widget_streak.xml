<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/widget_streak_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_appwidget_root"
	android:padding="12dp"
	android:theme="@style/Theme.Kotatsu.AppWidgetContainer">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:gravity="center_horizontal"
		android:orientation="vertical">

		<ImageView
			android:id="@+id/widget_streak_flame"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:contentDescription="@null"
			android:scaleType="fitCenter"
			android:padding="14dp"
			android:src="@drawable/ic_streak_flame" />

		<TextView
			android:id="@+id/widget_streak_value"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:includeFontPadding="false"
			android:maxLines="1"
			android:textColor="@color/kotatsu_onSurface"
			android:textSize="30sp"
			android:textStyle="bold"
			tools:text="80" />

		<TextView
			android:id="@+id/widget_streak_label"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:maxLines="1"
			android:text="@string/widget_streak_days"
			android:textColor="@color/kotatsu_onSurfaceVariant"
			android:textSize="12sp" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/widget_streak_best"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="top|end"
		android:background="@drawable/bg_appwidget_chip"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="8dp"
		android:paddingVertical="3dp"
		tools:ignore="UseCompoundDrawables">

		<ImageView
			android:id="@+id/widget_streak_best_icon"
			android:layout_width="12dp"
			android:layout_height="12dp"
			android:contentDescription="@string/widget_streak_best"
			android:src="@drawable/ic_trophy"
			android:tint="@color/kotatsu_onPrimaryContainer"
			tools:ignore="UseAppTint" />

		<TextView
			android:id="@+id/widget_streak_best_value"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="3dp"
			android:includeFontPadding="false"
			android:textColor="@color/kotatsu_onPrimaryContainer"
			android:textSize="11sp"
			android:textStyle="bold"
			tools:text="80" />
	</LinearLayout>
</FrameLayout>
