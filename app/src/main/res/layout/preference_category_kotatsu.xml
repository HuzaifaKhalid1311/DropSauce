<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 28: Material 3 Expressive section label between groups of
    preference cards. Tighter than a hero heading - the Pixel-style
    settings use a quiet LabelMedium-sized label in colorPrimary so the
    rounded row cards do the visual heavy lifting.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary"
        android:fontFamily="@font/display"
        android:textAllCaps="false"
        android:letterSpacing="0.02" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginTop="4dp" />

</LinearLayout>
