<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/list_selector"
	android:clipChildren="false"
	android:paddingBottom="@dimen/list_spacing_small"
	tools:layout_width="80dp">

	<!-- Fills the whole cell width (extension icons carry their own transparent border) -->
	<org.koitharu.kotatsu.core.ui.image.FaviconView
		android:id="@+id/imageView_icon"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:background="?colorControlHighlight"
		android:labelFor="@id/textView_title"
		android:padding="1dp"
		android:scaleType="fitCenter"
		app:iconStyle="@style/FaviconDrawable.Large"
		app:layout_constraintDimensionRatio="1:1"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:shapeAppearance="?shapeAppearanceCornerMedium"
		app:strokeColor="?colorOutline"
		app:strokeWidth="1dp" />

	<!-- Kept to the icon's width, right under it -->
	<TextView
		android:id="@+id/textView_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginTop="2dp"
		android:paddingHorizontal="2dp"
		android:drawablePadding="1dp"
		android:elegantTextHeight="false"
		android:ellipsize="end"
		android:gravity="center_horizontal"
		android:hyphenationFrequency="none"
		android:maxLines="2"
		android:textAlignment="center"
		android:textAppearance="?attr/textAppearanceLabelMedium"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/imageView_icon"
		tools:drawableStart="@drawable/ic_pin_small"
		tools:text="@tools:sample/lorem[0]" />

</androidx.constraintlayout.widget.ConstraintLayout>
