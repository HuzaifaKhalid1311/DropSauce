<?xml version="1.0" encoding="utf-8"?>
<!-- Suggestions / related titles: a Material 3 multi-browse carousel of cover posters
     (CarouselLayoutManager + MultiBrowseCarouselStrategy are set in code), titles laid over the
     covers. Until the suggestions load it holds blank skeleton tiles, so the list doesn't jump and the
     skeleton matches exactly. Hosted by Compose (Explore, details), which sets the height
     (SUGGESTIONS_CAROUSEL_HEIGHT) and places it 8dp inside the screen edges, so scrolled-off tiles
     stop at the same 12dp gap on both. Explore keeps the 6dp side padding here (first tile on its
     16dp content edge with the tile's 2dp margin); details sets its own. -->
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<org.koitharu.kotatsu.core.ui.widgets.CarouselRecyclerView
		android:id="@+id/recyclerView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:nestedScrollingEnabled="false"
		android:orientation="horizontal"
		android:paddingHorizontal="6dp"
		tools:listitem="@layout/item_manga_carousel" />

</FrameLayout>
