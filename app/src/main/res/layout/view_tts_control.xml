<?xml version="1.0" encoding="utf-8"?>
<merge
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	tools:background="@drawable/bg_reader_panel"
	tools:layout_height="wrap_content"
	tools:layout_margin="@dimen/screen_padding"
	tools:layout_width="match_parent"
	tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

	<ImageView
		android:id="@+id/icon_tts"
		android:layout_width="20dp"
		android:layout_height="20dp"
		android:layout_marginStart="20dp"
		android:contentDescription="@null"
		android:src="@drawable/ic_voice_over"
		app:layout_constraintBottom_toBottomOf="@id/textView_title"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="@id/textView_title"
		app:tint="?colorPrimary" />

	<TextView
		android:id="@+id/textView_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="12dp"
		android:gravity="center_vertical"
		android:minHeight="56dp"
		android:text="@string/text_to_speech"
		android:textAppearance="?textAppearanceTitleMedium"
		app:layout_constraintEnd_toStartOf="@id/button_close"
		app:layout_constraintStart_toEndOf="@id/icon_tts"
		app:layout_constraintTop_toTopOf="parent" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_close"
		style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginEnd="12dp"
		android:contentDescription="@string/close"
		android:insetTop="0dp"
		android:insetBottom="0dp"
		app:cornerRadius="20dp"
		app:icon="@drawable/ic_close"
		app:iconGravity="textStart"
		app:iconPadding="0dp"
		app:iconSize="20dp"
		app:layout_constraintBottom_toBottomOf="@id/textView_title"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@id/textView_title" />

	<LinearLayout
		android:id="@+id/container_sections"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="12dp"
		android:layout_marginBottom="12dp"
		android:background="@drawable/bg_reader_panel_item"
		android:orientation="vertical"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/textView_title">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:orientation="horizontal"
			android:paddingTop="16dp"
			android:paddingBottom="4dp">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_previous"
				style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:contentDescription="@string/tts_previous_sentence"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				app:cornerRadius="24dp"
				app:icon="@drawable/ic_skip_previous"
				app:iconGravity="textStart"
				app:iconPadding="0dp"
				app:iconSize="24dp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_play"
				style="@style/Widget.Material3Expressive.Button.IconButton.Filled"
				android:layout_width="64dp"
				android:layout_height="64dp"
				android:layout_marginHorizontal="20dp"
				android:contentDescription="@string/resume"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				app:cornerRadius="32dp"
				app:icon="@drawable/ic_play"
				app:iconGravity="textStart"
				app:iconPadding="0dp"
				app:iconSize="30dp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_next"
				style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:contentDescription="@string/tts_next_sentence"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				app:cornerRadius="24dp"
				app:icon="@drawable/ic_skip_next"
				app:iconGravity="textStart"
				app:iconPadding="0dp"
				app:iconSize="24dp" />
		</LinearLayout>

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:paddingHorizontal="16dp"
			android:paddingBottom="4dp"
			android:text="@string/tts_tap_hint"
			android:textAppearance="?textAppearanceBodySmall"
			android:textColor="?android:textColorSecondary" />

		<TextView
			android:id="@+id/label_voice"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:paddingHorizontal="16dp"
			android:text="@string/tts_voice"
			android:textAppearance="?attr/textAppearanceTitleSmall" />

		<com.google.android.material.button.MaterialButtonToggleGroup
			android:id="@+id/group_voices"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="10dp"
			android:layout_marginBottom="16dp"
			app:selectionRequired="true"
			app:singleSelection="true">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_voice_0"
				style="@style/Widget.Kotatsu.TtsVoiceButton"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:text="1" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_voice_1"
				style="@style/Widget.Kotatsu.TtsVoiceButton"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:text="2" />
		</com.google.android.material.button.MaterialButtonToggleGroup>

		<TextView
			android:id="@+id/label_speed"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingHorizontal="16dp"
			android:text="@string/speed"
			android:textAppearance="?attr/textAppearanceTitleSmall" />

		<com.google.android.material.slider.Slider
			android:id="@+id/slider_speed"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="16dp"
			android:contentDescription="@string/speed"
			android:stepSize="0.05"
			android:valueFrom="0.5"
			android:valueTo="2.5"
			app:labelBehavior="floating" />

		<TextView
			android:id="@+id/label_pitch"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingHorizontal="16dp"
			android:text="@string/tts_pitch"
			android:textAppearance="?attr/textAppearanceTitleSmall" />

		<com.google.android.material.slider.Slider
			android:id="@+id/slider_pitch"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="16dp"
			android:layout_marginBottom="8dp"
			android:contentDescription="@string/tts_pitch"
			android:stepSize="0.05"
			android:valueFrom="0.5"
			android:valueTo="2.0"
			app:labelBehavior="floating" />

	</LinearLayout>

</merge>
