<?xml version="1.0" encoding="utf-8"?>
<!-- Explore's extension header: title, a full-width source-kind rail, then Manage. -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingHorizontal="@dimen/grid_spacing"
	android:paddingVertical="@dimen/grid_spacing">

	<TextView
		android:id="@+id/textView_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:ellipsize="end"
		android:singleLine="true"
		android:text="@string/extensions"
		android:textAppearance="?textAppearanceTitleSmall" />

	<FrameLayout
		android:layout_width="0dp"
		android:layout_height="48dp"
		android:layout_marginHorizontal="@dimen/margin_normal"
		android:layout_weight="1"
		android:background="@drawable/bg_explore_kind_rail">

		<com.google.android.material.tabs.TabLayout
			android:id="@+id/tabs_kind"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@null"
			app:tabGravity="fill"
			app:tabIndicatorAnimationMode="elastic"
			app:tabIndicatorColor="?attr/colorPrimary"
			app:tabIndicatorFullWidth="false"
			app:tabIndicatorHeight="3dp"
			app:tabMode="fixed"
			app:tabRippleColor="@null"
			app:tabSelectedTextColor="?attr/colorPrimary"
			app:tabTextAppearance="?textAppearanceLabelLarge"
			app:tabTextColor="?attr/colorOnSurfaceVariant" />

		<View
			android:layout_width="1dp"
			android:layout_height="20dp"
			android:layout_gravity="center"
			android:background="?attr/colorOutlineVariant"
			android:importantForAccessibility="no" />

	</FrameLayout>

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_more"
		style="@style/Widget.Kotatsu.Button.More.Small"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:minWidth="40dp"
		android:minHeight="32dp"
		android:text="@string/manage"
		tools:text="@string/manage" />

</LinearLayout>
