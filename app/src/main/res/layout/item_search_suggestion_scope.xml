<?xml version="1.0" encoding="utf-8"?>
<!-- Manga/novel switch pinned above the search suggestions. -->
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingStart="?listPreferredItemPaddingStart"
	android:paddingEnd="?listPreferredItemPaddingEnd"
	android:paddingTop="4dp"
	android:paddingBottom="8dp">

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/group_scope"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:selectionRequired="true"
		app:singleSelection="true">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_manga"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/content_type_manga"
			app:icon="@drawable/ic_scope_manga"
			app:iconGravity="textStart" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_novel"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/content_type_novel"
			app:icon="@drawable/ic_scope_novel"
			app:iconGravity="textStart" />

	</com.google.android.material.button.MaterialButtonToggleGroup>

</FrameLayout>
