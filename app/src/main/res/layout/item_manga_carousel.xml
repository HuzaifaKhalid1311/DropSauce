<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Expressive carousel item: a MaskableFrameLayout (required so the
     CarouselLayoutManager can mask/unmask it on scroll) holding a full-bleed cover with the title
     laid over its bottom edge. The title fades out as the tile narrows (see fadeTitleWithMask). -->
<org.koitharu.kotatsu.core.ui.widgets.EdgeMaskableFrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/carousel_item"
	android:layout_width="150dp"
	android:layout_height="match_parent"
	android:layout_marginStart="@dimen/grid_spacing_outer"
	android:layout_marginEnd="@dimen/grid_spacing_outer"
	android:foreground="?attr/selectableItemBackground"
	app:shapeAppearance="@style/ShapeAppearanceOverlay.Kotatsu.CarouselItem">

	<org.koitharu.kotatsu.image.ui.CoverImageView
		android:id="@+id/imageView_cover"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="?colorSurfaceContainer"
		android:scaleType="centerCrop"
		app:allowRgb565="true"
		app:aspectRationHeight="0"
		app:aspectRationWidth="0"
		tools:ignore="ContentDescription"
		tools:src="@tools:sample/backgrounds/scenic[5]" />

	<TextView
		android:id="@+id/textView_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:background="@drawable/bg_carousel_title_scrim"
		android:elegantTextHeight="false"
		android:ellipsize="end"
		android:maxLines="2"
		android:paddingStart="10dp"
		android:paddingTop="28dp"
		android:paddingEnd="8dp"
		android:paddingBottom="10dp"
		android:shadowColor="#66000000"
		android:shadowRadius="4"
		android:textAppearance="?attr/textAppearanceLabelMedium"
		android:textColor="@android:color/white"
		tools:text="@tools:sample/lorem" />

</org.koitharu.kotatsu.core.ui.widgets.EdgeMaskableFrameLayout>
