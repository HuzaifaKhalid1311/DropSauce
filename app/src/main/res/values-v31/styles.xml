<?xml version="1.0" encoding="utf-8"?>
<resources>

	<!-- A light blur behind popups instead of the dim. The blur is drawn on the dim layer, so a trace of dim
	     has to stay or there's no blur at all. Where blur is off, ExpressiveDialogCard brings the dim back. -->
	<style name="ThemeOverlay.Kotatsu.Dialog" parent="@android:style/ThemeOverlay.Material.Dialog">
		<item name="android:windowAnimationStyle">@style/Animation.Kotatsu.Popup</item>
		<item name="android:backgroundDimAmount">0.01</item>
		<item name="android:windowBlurBehindEnabled">true</item>
		<item name="android:windowBlurBehindRadius">6dp</item>
	</style>

</resources>
