<?xml version="1.0" encoding="utf-8"?>
<resources>

	<!-- The system compositor blurs behind the popup window, so the blur fades in and out with the dim and the popup animation. -->
	<style name="ThemeOverlay.Kotatsu.Dialog" parent="@android:style/ThemeOverlay.Material.Dialog">
		<item name="android:windowAnimationStyle">@style/Animation.Kotatsu.Popup</item>
		<item name="android:backgroundDimAmount">0.25</item>
		<item name="android:windowBlurBehindEnabled">true</item>
		<item name="android:windowBlurBehindRadius">6dp</item>
	</style>

</resources>
