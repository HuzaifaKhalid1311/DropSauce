<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 Expressive type scale.
    Display / Headline / Title.Large → display font (rounded, expressive).
    Title.Medium / Title.Small / Body.* / Label.* → body font (Montserrat).

    Variable-axis weight is applied via android:fontVariationSettings on API 26+;
    older devices fall back to the static cuts the Downloadable Fonts provider
    serves.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

	<!-- Display -->
	<style name="TextAppearance.Kotatsu.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
		<item name="android:fontFamily">@font/display</item>
		<item name="fontFamily">@font/display</item>
		<item name="android:fontVariationSettings" tools:targetApi="o">\'wght\' 400</item>
	</style>
	<style name="TextAppearance.Kotatsu.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
		<item name="android:fontFamily">@font/display</item>
		<item name="fontFamily">@font/display</item>
		<item name="android:fontVariationSettings" tools:targetApi="o">\'wght\' 400</item>
	</style>
	<style name="TextAppearance.Kotatsu.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
		<item name="android:fontFamily">@font/display</item>
		<item name="fontFamily">@font/display</item>
		<item name="android:fontVariationSettings" tools:targetApi="o">\'wght\' 400</item>
	</style>

	<!-- Headline -->
	<style name="TextAppearance.Kotatsu.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
		<item name="android:fontFamily">@font/display</item>
		<item name="fontFamily">@font/display</item>
