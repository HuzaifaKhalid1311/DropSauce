		<item name="textAppearanceLabelSmall">@style/TextAppearance.Kotatsu.LabelSmall</item>
	</style>

	<!--== Default Theme ==-->
	<style name="Theme.Kotatsu" parent="Base.Theme.Kotatsu" />

	<!-- Base ThemeOverlay -->
	<style name="ThemeOverlay.Kotatsu" parent="ThemeOverlay.Material3.Light">
		<item name="popupMenuStyle">@style/Widget.Kotatsu.PopupMenu</item>
		<item name="actionOverflowMenuStyle">@style/Widget.Kotatsu.PopupMenu.Overflow</item>
	</style>

	<!-- Monet theme only supports S+ -->
	<style name="ThemeOverlay.Kotatsu.Monet" parent="ThemeOverlay.Material3.DynamicColors.Light" />

	<!--
	    Expressive is now the baseline (Base.Theme.Kotatsu inherits from
	    Theme.Material3Expressive.DayNight.NoActionBar). This overlay is preserved
	    as a no-op so any lingering R.style.ThemeOverlay_Kotatsu_Expressive reference
	    still resolves; remove after a release cycle.
	-->
	<style name="ThemeOverlay.Kotatsu.Expressive" parent="" />

	<!-- Phase 2.3: AMOLED clamp - pure black surfaces for OLED users -->
	<style name="ThemeOverlay.Kotatsu.Amoled" parent="">
		<item name="android:colorBackground">@android:color/black</item>
		<item name="colorSurface">@android:color/black</item>
		<item name="colorSurfaceDim">@android:color/black</item>
		<item name="colorSurfaceBright">#1A1A1A</item>
		<item name="colorSurfaceContainerLowest">@android:color/black</item>
		<item name="colorSurfaceContainerLow">#0A0A0A</item>
		<item name="colorSurfaceContainer">#121212</item>
		<item name="colorSurfaceContainerHigh">#1A1A1A</item>
		<item name="colorSurfaceContainerHighest">#222222</item>
		<item name="android:windowBackground">@android:color/black</item>
	</style>

	<!-- App Widgets -->

	<style name="Theme.Kotatsu.AppWidgetContainer" parent="@style/Theme.MaterialComponents.Light">
		<item name="android:colorBackground">@color/kotatsu_background</item>
		<item name="android:panelColorBackground">@color/kotatsu_primaryContainer</item>
	</style>
</resources>
