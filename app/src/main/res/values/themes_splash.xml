<?xml version="1.0" encoding="utf-8"?>
<resources>

	<!-- Launch theme of MainActivity. On Android 13+ the per-scheme children below are handed to
	     the system (SplashScreen.setSplashScreenTheme) so the next launch matches the colour scheme. -->
	<style name="Theme.Kotatsu.Splash" parent="Theme.SplashScreen">
		<item name="windowSplashScreenBackground">@color/splash_background</item>
		<item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
		<item name="windowSplashScreenAnimationDuration">@integer/splash_screen_duration</item>
		<item name="splashShapeColor">@color/splash_shape</item>
		<item name="splashLogoColor">@color/splash_logo</item>
		<item name="postSplashScreenTheme">@style/Theme.Kotatsu</item>
	</style>

	<!-- Expressive follows the wallpaper, which is what the defaults do on Android 12+ -->
	<style name="Theme.Kotatsu.Splash.Expressive" />

	<style name="Theme.Kotatsu.Splash.Totoro">
		<item name="windowSplashScreenBackground">@color/totoro_surfaceContainer</item>
		<item name="splashShapeColor">@color/totoro_primary</item>
		<item name="splashLogoColor">@color/totoro_onPrimary</item>
	</style>

