<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
	<objectAnimator
		android:duration="@integer/nav_tab_enter_duration"
		android:interpolator="@interpolator/nav_tab_fade_in"
		android:propertyName="alpha"
		android:valueFrom="0"
		android:valueTo="1"
		android:valueType="floatType" />
	<objectAnimator
		android:duration="@integer/nav_tab_enter_duration"
		android:interpolator="@interpolator/nav_tab_enter"
		android:propertyName="translationX"
		android:valueFrom="@dimen/nav_tab_slide_distance"
		android:valueTo="0dp"
		android:valueType="floatType" />
	<objectAnimator
		android:duration="@integer/nav_tab_enter_duration"
		android:interpolator="@interpolator/nav_tab_enter"
		android:propertyName="scaleX"
		android:valueFrom="0.97"
		android:valueTo="1"
		android:valueType="floatType" />
	<objectAnimator
		android:duration="@integer/nav_tab_enter_duration"
		android:interpolator="@interpolator/nav_tab_enter"
		android:propertyName="scaleY"
		android:valueFrom="0.97"
		android:valueTo="1"
		android:valueType="floatType" />
</set>
