<?xml version="1.0" encoding="utf-8"?>
<!-- Container behind the search field while typing: same tone and pill shape as the inactive
     search bar on the home screen, inset so it sits like that bar instead of a full-bleed band. -->
<inset
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:insetLeft="@dimen/search_bar_margin_horizontal"
	android:insetRight="@dimen/search_bar_margin_horizontal">

	<shape android:shape="rectangle">
		<corners android:radius="32dp" />
		<solid android:color="?attr/colorSurfaceContainer" />
	</shape>

</inset>
