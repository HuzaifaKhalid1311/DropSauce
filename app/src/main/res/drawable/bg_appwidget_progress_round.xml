<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:id="@android:id/background">
		<shape>
			<corners android:radius="3dp" />
			<solid android:color="@color/kotatsu_surfaceContainerHighest" />
		</shape>
	</item>
	<!-- `scale` instead of `clip` so the filled part keeps rounded caps at both ends
	     instead of being sliced off square. -->
	<item android:id="@android:id/progress">
		<scale android:scaleWidth="100%">
			<shape>
				<corners android:radius="3dp" />
				<solid android:color="@color/kotatsu_primary" />
			</shape>
		</scale>
	</item>
</layer-list>
