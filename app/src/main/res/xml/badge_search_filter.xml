	xmlns:app="http://schemas.android.com/apk/res-auto"
	app:backgroundColor="?attr/colorPrimary"
	app:badgeGravity="BOTTOM_END"
	app:badgeRadius="5dp"
	app:horizontalOffset="-2dp"
	app:verticalOffset="-2dp" />
