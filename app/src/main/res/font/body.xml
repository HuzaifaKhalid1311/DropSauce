<?xml version="1.0" encoding="utf-8"?>
<!--
    Body face: Montserrat (variable-weight). Bundled locally so typography
    works on first launch with no network and on devices without Google
    Play Services. Variable axis weight is controlled per text appearance
    via android:fontVariationSettings 'wght' <value>.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/montserrat"
        android:fontStyle="normal"
        android:fontWeight="400" />
</font-family>
