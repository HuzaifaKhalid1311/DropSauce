<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 fade-through. The outgoing view clears in 105ms before the incoming one starts,
     so the two never wash over each other mid-transition. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
	android:duration="105"
	android:fromAlpha="1"
	android:interpolator="@interpolator/m3_easing_emphasized_accelerate"
	android:toAlpha="0" />
