<?xml version="1.0" encoding="utf-8"?>
<!-- Popup window shrinks slightly towards its centre while fading out. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
	android:duration="160"
	android:interpolator="@interpolator/m3_easing_emphasized_accelerate">

	<scale
		android:fromXScale="1"
		android:fromYScale="1"
		android:pivotX="50%"
		android:pivotY="50%"
		android:toXScale="0.9"
		android:toYScale="0.9" />

	<alpha
		android:fromAlpha="1"
		android:toAlpha="0" />

</set>
